COMPOSE_PROJECT_NAME=supabase

# Replace every secret before deploying to Dokploy.
POSTGRES_PASSWORD=change-this-postgres-password
JWT_SECRET=change-this-jwt-secret-with-at-least-32-characters
ANON_KEY=replace-with-generated-anon-jwt
SERVICE_ROLE_KEY=replace-with-generated-service-role-jwt
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=
JWT_KEYS=
JWT_JWKS=
ANON_KEY_ASYMMETRIC=
SERVICE_ROLE_KEY_ASYMMETRIC=

DASHBOARD_USERNAME=supabase
DASHBOARD_PASSWORD=changeThisDashboardPassword123
SECRET_KEY_BASE=change-this-secret-key-base-with-at-least-64-characters-total
VAULT_ENC_KEY=change-this-32-char-vault-key!!
PG_META_CRYPTO_KEY=change-this-pg-meta-crypto-key-32
LOGFLARE_PUBLIC_ACCESS_TOKEN=change-this-logflare-public-token
LOGFLARE_PRIVATE_ACCESS_TOKEN=change-this-logflare-private-token
S3_PROTOCOL_ACCESS_KEY_ID=change-this-s3-access-key-id
S3_PROTOCOL_ACCESS_KEY_SECRET=change-this-s3-access-key-secret

# Public URLs. Behind Dokploy/Traefik, use the HTTPS domain without :8000.
SUPABASE_PUBLIC_URL=https://supabase.example.com
API_EXTERNAL_URL=https://supabase.example.com
SITE_URL=https://app.example.com
ADDITIONAL_REDIRECT_URLS=

POSTGRES_HOST=db
POSTGRES_DB=postgres
POSTGRES_PORT=5432

POOLER_PROXY_PORT_TRANSACTION=6543
POOLER_DEFAULT_POOL_SIZE=20
POOLER_MAX_CLIENT_CONN=100
POOLER_TENANT_ID=default
POOLER_DB_POOL_SIZE=5

STUDIO_DEFAULT_ORGANIZATION="Default Organization"
STUDIO_DEFAULT_PROJECT="Default Project"
OPENAI_API_KEY=

JWT_EXPIRY=3600
DISABLE_SIGNUP=false

MAILER_URLPATHS_CONFIRMATION=/auth/v1/verify
MAILER_URLPATHS_INVITE=/auth/v1/verify
MAILER_URLPATHS_RECOVERY=/auth/v1/verify
MAILER_URLPATHS_EMAIL_CHANGE=/auth/v1/verify

ENABLE_EMAIL_SIGNUP=true
ENABLE_EMAIL_AUTOCONFIRM=false
ENABLE_ANONYMOUS_USERS=false
SMTP_ADMIN_EMAIL=admin@example.com
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=change-this-smtp-user
SMTP_PASS=change-this-smtp-password
SMTP_SENDER_NAME=Supabase

ENABLE_PHONE_SIGNUP=true
ENABLE_PHONE_AUTOCONFIRM=true

GLOBAL_S3_BUCKET=stub
REGION=stub
STORAGE_TENANT_ID=stub

FUNCTIONS_VERIFY_JWT=false

PGRST_DB_SCHEMAS=public,storage,graphql_public
PGRST_DB_MAX_ROWS=1000
PGRST_DB_EXTRA_SEARCH_PATH=public

DOCKER_SOCKET_LOCATION=/var/run/docker.sock

KONG_HTTP_PORT=51000

IMGPROXY_AUTO_WEBP=true
